# --- LLM (OpenRouter, OpenAI-compatible) ---
# OpenRouter API key for the analyzer's deep-dive (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# --- GitHub ---
# Token with read access to upstream & fork repos (REST API + fork clone).
GH_TOKEN=

# --- Mattermost (optional) ---
# Incoming-webhook URL for the nightly notification. Create it in Mattermost:
# channel → Integrations → Incoming Webhooks → Add. Leave blank to disable
# (the notify step no-ops cleanly when unset). In CI, set it as the GitHub
# Actions secret MATTERMOST_WEBHOOK_URL.
MATTERMOST_WEBHOOK_URL=

# Optional overrides (sane defaults baked into config.py).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-pro
LLM_TEMPERATURE=0.0

# --- Paths ---
# The registry (registries/upstream-tracker-<set>.yaml) and state snapshot
# (state/processed-<set>.json) are selected by the release-set CLI argument
# (e.g. `python -m tracker.main 1.36`), not by env vars. TRACKER_PATH/STATE_PATH
# below are optional explicit overrides (mainly for tests); leave them unset.
# TRACKER_PATH=
# STATE_PATH=
ARTIFACT_DIR=artifacts

# --- Dispatch ---
# Max concurrent repo sub-graphs. Unset => derive from CPU count. Lower it if
# memory (not cores) is the bottleneck for trial merges.
DISPATCH_MAX_WORKERS=
