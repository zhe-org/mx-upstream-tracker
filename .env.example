# --- LLM (GitHub Copilot, OpenAI-compatible) ---
# Personal / CI token with access to Copilot + read access to upstream & fork repos.
GH_TOKEN=

# Optional overrides (sane defaults baked into config.py).
LLM_BASE_URL=https://api.githubcopilot.com
LLM_MODEL=gemini-2.5-pro
LLM_TEMPERATURE=0.0

# --- Paths ---
TRACKER_PATH=upstream-tracker.yaml
STATE_PATH=state/processed.json
ARTIFACT_DIR=artifacts

# --- Dispatch ---
# Max concurrent repo sub-graphs. Unset => derive from CPU count. Lower it if
# memory (not cores) is the bottleneck for trial merges.
DISPATCH_MAX_WORKERS=
